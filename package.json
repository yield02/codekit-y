{
  "name": "codekit-y",
  "version": "0.1.0",
  "description": "AI Code Kit: shared, per-branch, lazily-built codebase maps for Claude Code, Cursor and Copilot, stored outside the source repo.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codekit": "dist/cli/codekit.js",
    "codemap": "dist/cli/codemap.js",
    "codemap-mcp": "dist/mcp/main.js"
  },
  "files": [
    "dist",
    "templates",
    "plugins"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
