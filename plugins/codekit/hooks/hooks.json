{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/../../dist/cli/codemap.js\" hook session-start", "timeout": 60 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/../../dist/cli/codemap.js\" hook prompt", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Read|Edit|Write|MultiEdit|NotebookEdit)$|^mcp__.*serena.*__",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/../../dist/cli/codemap.js\" hook track", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/../../dist/cli/codemap.js\" hook stop", "timeout": 60 }
        ]
      }
    ]
  }
}
